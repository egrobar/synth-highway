# audio and generated data stay out of the repo
*.mp3
*.wav
*.flac
*.ogg
*.m4a
out/
input/
stems/
*.lyrics.json

# python
.venv/
venv/
__pycache__/
*.pyc

# editors / os
.vscode/
.idea/
Thumbs.db
.DS_Store

# Godot build (generated)
game/.godot/
tools/song/build/

# Song importer environment (tools/setup_pipeline.sh)
.venv-pipeline/

# Generated audio: rebuild with tools/build_assets.sh (needs SuperCollider).
# The scripts in tools/ are the source; the WAV renders are build output (~360 MB).
game/assets/**/*.wav
game/assets/**/*.wav.import

# Built-in songs imported from the space game radio (tools/importer/import_radio.sh): their
# stems are rebuilt from space-mmo, so only the charts (game/data/songs) are committed.
game/assets/songs/**/*.ogg
game/assets/songs/**/*.ogg.import

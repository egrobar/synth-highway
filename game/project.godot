; Synth Highway, the Godot build. Generated by hand and kept minimal.
; Input and frame-rate settings are deliberate: Godot gives key events no
; timestamp, so a press is timed by whichever frame sees it. A high uncapped
; frame rate is what keeps that error to a few milliseconds.

config_version=5

[application]

config/name="Synth Highway"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=240

[audio]

driver/output_latency=15

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[input_devices]

buffering/agile_event_flushing=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=2

[importer_defaults]

texture={
"mipmaps/generate": true
}

[autoload]

WasdMultiplayer="*res://addons/wasd_multiplayer/wasd_multiplayer.gd"
Battle="*res://scripts/battle/battle.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/wasd_multiplayer/plugin.cfg")

class_name Chart
extends RefCounted
## A playable song: the notes plus the metadata needed to stage it.
##
## Chart files are generated by tools/song/make_song.py. Only notes at or above
## HOLD_MIN_SECONDS are holds, so ordinary melody notes stay simple taps.
##
## Three levels: easy, normal and hard ("difficulties" in the file). Hard arrived after the
## first charts (playtest, 2026-11-11: "needs a hard mode"), so older charts and imports made
## before it have no hard list: has_level() says so, menus offer Hard only where it exists,
## and load_file() falls back to the next level down rather than failing.
##
## A POWER NOTE (Hard only) is two, rarely three, notes at the same time on different lanes,
## each carrying "pw": 1 in the file: the biggest hits in the music (drum slams, drops). Each
## note is still judged on its own key; power_chords() groups them for the highway.

const HOLD_MIN_SECONDS := 0.75
## Notes this close together are one chord, struck at once, not a fast run.
const CHORD_SECONDS := 0.03

enum NoteState { PENDING, HIT, MISSED }
enum HoldState { NONE, HOLDING, COMPLETE, DROPPED }


class Note:
	extends RefCounted
	var t: float
	var d: float
	var p: int
	## What the player presses: 0 (A) to 9 (;) on the home row, 10-18 for sharps (see KeyMap).
	var lane: int
	var is_hold: bool
	var state: Chart.NoteState = Chart.NoteState.PENDING
	var hold_state: Chart.HoldState = Chart.HoldState.NONE
	var verdict: String = ""
	## Seconds of the note's length the player has held so far.
	var sustained: float = 0.0
	## Part of a power chord ("pw": 1): drawn joined to the chord's other notes.
	var power: bool = false

	func _init(start: float, length: float, midi_pitch: int, home_lane: int = -1, sharp: bool = false,
			is_power: bool = false) -> void:
		t = start
		d = length
		p = midi_pitch
		power = is_power
		# Charts from before the home-row layout carry no lane: count white keys up from C4.
		lane = home_lane if home_lane >= 0 else Chart.fallback_lane(midi_pitch)
		if sharp:
			lane += KeyMap.SHARP_BASE
		is_hold = length >= Chart.HOLD_MIN_SECONDS

	func end_time() -> float:
		return t + d

	func reset() -> void:
		state = Chart.NoteState.PENDING
		hold_state = Chart.HoldState.NONE
		verdict = ""
		sustained = 0.0


const DIFFICULTIES: Array[String] = ["easy", "normal", "hard"]
## Where each level falls back to when a chart does not carry it: the next level down first.
const FALLBACKS := {"hard": ["normal", "easy"], "normal": ["easy", "hard"], "easy": ["normal", "hard"]}

var id: String = ""
var title: String = ""
var theme: String = ""
var source: String = "builtin"
var difficulty: String = "normal"
var bpm: float = 120.0
var beats_per_bar: int = 4
## Seconds from the start of the audio to the first downbeat, for imported songs.
var beat_offset: float = 0.0
var duration: float = 0.0
var backing_path: String = ""
var lead_path: String = ""
var sections: Array = []
var notes: Array[Note] = []
var file_path: String = ""


## Reads a chart at one difficulty. Imported songs name their audio relative to
## the chart file, built-in songs by res:// path.
static func load_file(path: String, level: String = "normal") -> Chart:
	var data: Dictionary = read_meta(path)
	assert(not data.is_empty(), "Could not read chart: " + path)
	var chart := Chart.new()
	chart.file_path = path
	chart.id = data["id"]
	chart.title = data["title"]
	chart.theme = data["theme"]
	chart.source = data.get("source", "builtin")
	chart.bpm = data["bpm"]
	chart.beats_per_bar = int(data["beats_per_bar"])
	chart.beat_offset = float(data.get("beat_offset", 0.0))
	chart.duration = data["duration"]
	chart.backing_path = _resolve(path, data["backing"])
	chart.lead_path = _resolve(path, data["lead"])
	chart.sections = data.get("sections", [])
	var levels: Dictionary = data.get("difficulties", {})
	chart.difficulty = resolve_level(data, level)
	var raw_notes: Array = levels.get(chart.difficulty, data.get("notes", []))
	for raw: Dictionary in raw_notes:
		chart.notes.append(Note.new(raw["t"], raw["d"], int(raw["p"]), int(raw.get("l", -1)), int(raw.get("s", 0)) == 1,
			int(raw.get("pw", 0)) == 1))
	# Ties broken by lane, so a chord's notes always come in the same order.
	chart.notes.sort_custom(func(a: Note, b: Note) -> bool: return a.t < b.t or (a.t == b.t and a.lane < b.lane))
	return chart


## Whether the chart file carries notes for `level`. A chart from before difficulty levels has
## one "notes" list, which plays as Normal.
static func has_level(meta: Dictionary, level: String) -> bool:
	var levels: Dictionary = meta.get("difficulties", {})
	if not (levels.get(level, []) as Array).is_empty():
		return true
	return level == "normal" and levels.is_empty() and not (meta.get("notes", []) as Array).is_empty()


## The levels a menu offers for a chart: Easy and Normal always (an old chart plays its one list
## for both), Hard only where it has been charted.
static func playable_levels(meta: Dictionary) -> Array[String]:
	var out: Array[String] = ["easy", "normal"]
	if has_level(meta, "hard"):
		out.append("hard")
	return out


## The level load_file will actually play for a request: `level` if the chart carries it, else
## the next level down (Hard -> Normal -> Easy), else "normal" for a one-list chart.
static func resolve_level(meta: Dictionary, level: String) -> String:
	if has_level(meta, level):
		return level
	for other: String in FALLBACKS.get(level, ["normal", "easy", "hard"]):
		if has_level(meta, other):
			return other
	return "normal"


## The chart's JSON without building notes, for menus. Empty if unreadable.
static func read_meta(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	return parsed if parsed is Dictionary else {}


static func _resolve(chart_path: String, audio: String) -> String:
	if audio.contains("://") or audio.is_absolute_path():
		return audio
	return chart_path.get_base_dir().path_join(audio)


## Builds a chart directly from [time, duration, lane] triples, for tests. A fourth value of 1
## marks a power note.
static func from_triples(triples: Array) -> Chart:
	var chart := Chart.new()
	for row: Array in triples:
		chart.notes.append(Note.new(row[0], row[1], 60, int(row[2]), false, row.size() > 3 and int(row[3]) == 1))
	return chart


## White keys counted up from C4, clamped to the ten lanes. Only for charts without lanes.
static func fallback_lane(pitch: int) -> int:
	var whites: int = 0
	var step: int = 1 if pitch >= 60 else -1
	var p: int = 60
	while p != pitch:
		p += step
		if not [1, 3, 6, 8, 10].has(posmod(p, 12)):
			whites += step
	return clampi(whites, 0, KeyMap.COUNT - 1)


func reset() -> void:
	for note: Note in notes:
		note.reset()


## The power chords, each the Array of its notes (two or three, on different lanes), in time order.
func power_chords() -> Array:
	var chords: Array = []
	var current: Array = []
	for note: Note in notes:
		if not note.power:
			continue
		if not current.is_empty() and note.t - (current[0] as Note).t > CHORD_SECONDS:
			if current.size() > 1:
				chords.append(current)
			current = []
		current.append(note)
	if current.size() > 1:
		chords.append(current)
	return chords


func has_sharps() -> bool:
	for note: Note in notes:
		if KeyMap.is_sharp(note.lane):
			return true
	return false


func beat_seconds() -> float:
	return 60.0 / bpm


func last_note_end() -> float:
	var latest := 0.0
	for note: Note in notes:
		latest = maxf(latest, note.end_time())
	return latest
